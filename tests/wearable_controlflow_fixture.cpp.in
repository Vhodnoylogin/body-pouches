namespace Game {
inline std::function<void()> onDescribe,onHeld;
inline RE::TESBoundObject* held{};
inline Core::Item Describe(RE::AlchemyItem* potion) { auto f=std::exchange(onDescribe,{});if(f)f();return potion->item; }
struct PlayerPack { static RE::TESBoundObject* Held(const Core::FormKey&) { auto f=std::exchange(onHeld,{});if(f)f();return held; } };
}
// This controlled boundary models only copied admission/token changes. It is not
// an independent implementation or qualification of the production adapter/API.
struct AdmissionBoundary {
    VR::BodySlotsDemo::CopiedState state;
    bool provider=true,left=true,right=true;
    int reconciles{},allows{},invalidates{},resets{};
    AdmissionBoundary() { state.equipmentEpoch=1;state.view.saveGeneration=1;state.view.viewRevision=1; }
    VR::BodySlotsDemo::Token CurrentToken() const { return state.available?state.token:VR::BodySlotsDemo::Token{}; }
    void InvalidateEquipment() { ++invalidates;++state.equipmentEpoch;state.available=false;state.token={}; }
    void Reset() { ++resets;++state.equipmentEpoch;++state.view.saveGeneration;state.available=false;state.token={}; }
    void Reconcile(bool observed,bool worn) {
        ++reconciles;state.observed=observed;state.worn=observed&&worn;state.requestedActive=state.worn;
        state.available=provider&&state.worn;state.connected=provider;
        state.token=state.available?VR::BodySlotsDemo::Token{state.equipmentEpoch,state.view.saveGeneration,state.view.viewRevision,7,1}:VR::BodySlotsDemo::Token{};
    }
    VR::BodySlotsDemo::CopiedState Copy() const { return state; }
    bool Allows(bool isLeft,const VR::BodySlotsDemo::Token* token=nullptr) {
        ++allows;return provider&&state.available&&(isLeft?left:right)&&(!token||(token->Valid()&&*token==state.token));
    }
};
struct Clearable { bool active{};void Clear(){active=false;} };
struct PackBoundary : Core::Pack {
    std::vector<Core::Item> rows;
    std::vector<Core::Item> Matching(const Core::Filter& filter) const override {
        std::vector<Core::Item> result;for(const auto& row:rows)if(filter.Matches(row))result.push_back(row);return result;
    }
};
struct HiggsBoundary {
    RE::TESObjectREFR* held[2]{};bool canGrab=true;int grabs{};
    std::function<void()> onCanGrab;
    bool IsHolding(bool left) const {return held[left?0:1]!=nullptr;}
    RE::TESObjectREFR* Held(bool left) const {return held[left?0:1];}
    bool CanGrab(bool) {auto f=std::exchange(onCanGrab,{});if(f)f();return canGrab;}
    void Grab(RE::TESObjectREFR*,bool) {++grabs;}
};
struct VrikBoundary {
    int native=13,reads{};std::function<void()> onRead;
    int SlotInReach(bool) {++reads;auto f=std::exchange(onRead,{});if(f)f();return native;}
};
inline const char* HandName(bool left) {return left?"left":"right";}
inline std::int64_t Now(){return 1000;}
inline constexpr std::int64_t kGrabCheckMs=200;

class Mod {
public:
    inline static Mod* instance{};
    static Mod& GetSingleton(){return *instance;}
    Mod(){instance=this;}
    bool working=true,_dataLoaded=true,_restorePending=false,_demoActive=false;
    std::atomic<bool> _demoEquipmentDirty{false};
    RE::TESObjectARMO* _demoBag{};
    AdmissionBoundary _demoSlots;
    Core::PouchSet _pouches;
    PackBoundary _pack;
    Core::LoadGate _loadState;
    HiggsBoundary _higgs;
    VrikBoundary _vrik;
    std::mutex _lock;
    Core::PendingGrab _pendingGrab[2];
    RE::ObjectRefHandle _grabReference[2];
    Clearable _sharedPresses[2],_sharedWithdrawal[2],_sharedButtons[2];
    bool _drawQueued[2]{};
    int _reach[2]{},_drawnFrom[2]{};
    std::uint64_t _pendingDrawIds[2]{},_traceDrawSerial{},_worldGeneration=1,_higgsUpdate=1,_dropSerial{};
    bool _inHiggsUpdate=true;
    std::int64_t _displayAt=99;
    struct PendingRelease {Core::CurrentUpdateRelease event;RE::ObjectRefHandle handle;std::uint64_t serial{};VR::BodySlotsDemo::Token bagToken;};
    PendingRelease _pendingReleases[2];
    std::unordered_map<std::uint32_t,std::uint64_t> _queuedDrops;
    std::function<void(std::string_view)> onGeometry;
    std::function<void(Diagnostics::Event)> onTrace;
    bool Working()const{return working;}
    static bool IsSecondaryHand(bool left){return left;}
    static bool IsLeftHand(bool secondary){return secondary;}
    static bool HandPosition(bool,RE::NiPoint3& point){point={1,2,3};return true;}
    void NoteDropGeometry(bool,RE::TESObjectREFR*,const char* phase,std::uint64_t){if(onGeometry)onGeometry(phase);}
    template<class... T>void Trace(Diagnostics::Event event,T&&...){if(onTrace)onTrace(event);}
    class DemoEquipment {public:RE::BSEventNotifyControl ProcessEvent(const RE::TESEquipEvent*,RE::BSTEventSource<RE::TESEquipEvent>*);};
    void RefreshDemoEquipment();
    bool DemoAllows(int,bool,const VR::BodySlotsDemo::Token* =nullptr);
    int PouchAt(bool,int);
    void CancelPendingRelease(bool);
    void SettleOutsideDrop(bool);
    void ResolvePendingReleases();
    void QueueStowDropped(int,bool,RE::ObjectRefHandle,std::uint64_t,VR::BodySlotsDemo::Token);
    void InvalidateWorld();
    bool Draw(int,bool,const Core::FormKey&,std::uint64_t,const VR::BodySlotsDemo::Token&);
    void StowDropped(int,bool,RE::TESObjectREFR*,std::uint64_t,const VR::BodySlotsDemo::Token&);
    bool HandleHolsterAttempt(int,bool,bool);
    static void OnDropped(bool,::TESObjectREFR*);
    static void OnGrabbed(bool,::TESObjectREFR*);
};

@@METHODS@@
}
