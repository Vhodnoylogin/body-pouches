namespace {
int checks{},failures{};
#define CHECK(x) do{++checks;if(!(x)){++failures;std::cerr<<"FAIL "<<test<<":"<<__LINE__<<" " #x "\n";}}while(false)
struct World {
    BodyPouches::Mod mod;
    RE::PlayerCharacter player;
    RE::TESObjectARMO bag;
    RE::AlchemyItem potion;
    RE::TESObjectREFR bottle;
    World(bool assigned=true){
        RE::references.clear();SKSE::tasks.queue.clear();SKSE::available=true;
        BodyPouches::Game::onDescribe={};BodyPouches::Game::onHeld={};
        bag.id=0x01000803;player.armor=&bag;RE::PlayerCharacter::current=&player;mod._demoBag=&bag;
        potion.id=0x123;potion.item.key={"Skyrim.esm",0x123};potion.item.effects={{"Skyrim.esm",0x456}};potion.item.count=5;
        bottle.id=0xFF000001;bottle.handle=101;bottle.base=&potion;RE::references[101]=&bottle;
        player.removed=&bottle;BodyPouches::Game::held=&potion;mod._pack.rows={potion.item};
        mod._pouches.Set(BodyPouches::Core::Pouch(13,BodyPouches::Core::Mode::Exclusive));
        if(assigned)mod._pouches.Assign(13,potion.item);
        mod.RefreshDemoEquipment();
    }
    void Event(){RE::TESEquipEvent event{{&player},bag.id};BodyPouches::Mod::DemoEquipment sink;sink.ProcessEvent(&event,nullptr);}
    void OffOn(){player.worn=false;Event();player.worn=true;Event();}
    void FenceOffOn(){OffOn();mod.RefreshDemoEquipment();}
};
void Run(std::string_view test){
    using BodyPouches::Mod;
    if(test=="original_draw_capture"){
        World w;const auto original=w.mod._demoSlots.CurrentToken();w.mod._higgs.onCanGrab=[&]{w.FenceOffOn();};
        CHECK(!w.mod.HandleHolsterAttempt(13,true,false));CHECK(w.mod._demoSlots.CurrentToken()!=original);
        SKSE::tasks.Drain();CHECK(w.player.removeCalls==0);
    }else if(test=="unassigned_stow_fence"){
        World w(false);const auto token=w.mod._demoSlots.CurrentToken();BodyPouches::Game::onDescribe=[&]{w.OffOn();};
        w.mod.StowDropped(13,true,&w.bottle,1,token);CHECK(w.player.pickupCalls==0);CHECK(!w.mod._pouches.Find(13)->IsAssigned());
    }else if(test=="normal_return"){
        World w;auto token=w.mod._demoSlots.CurrentToken();Mod::OnDropped(true,&w.bottle);
        CHECK(w.mod._pendingReleases[0].bagToken==token);CHECK(w.mod._pendingReleases[0].event.Active());
        w.mod.ResolvePendingReleases();CHECK(SKSE::tasks.queue.size()==1);CHECK(w.player.pickupCalls==0);
        SKSE::tasks.Drain();CHECK(w.player.pickupCalls==1);CHECK(w.player.pickedQuantity==1);CHECK(w.mod._queuedDrops.empty());
    }else if(test=="off_on_before_resolve"){
        World w;Mod::OnDropped(true,&w.bottle);w.OffOn();w.mod.ResolvePendingReleases();SKSE::tasks.Drain();
        CHECK(w.player.pickupCalls==0);CHECK(SKSE::tasks.queue.empty());CHECK(w.mod._queuedDrops.empty());
    }else if(test=="original_event_capture"){
        World w;const auto original=w.mod._demoSlots.CurrentToken();w.bottle.onBase=[&]{w.FenceOffOn();};
        Mod::OnDropped(true,&w.bottle);CHECK(w.mod._pendingReleases[0].bagToken==original);
        CHECK(w.mod._demoSlots.CurrentToken()!=original);w.mod.ResolvePendingReleases();SKSE::tasks.Drain();CHECK(w.player.pickupCalls==0);
    }else if(test=="queue_no_recapture"){
        World w;Mod::OnDropped(true,&w.bottle);w.mod.onGeometry=[&](std::string_view phase){if(phase=="post_vrik_same_update")w.FenceOffOn();};
        w.mod.ResolvePendingReleases();CHECK(SKSE::tasks.queue.size()==1);SKSE::tasks.Drain();CHECK(w.player.pickupCalls==0);
    }else if(test=="queued_return_epoch"){
        World w;Mod::OnDropped(true,&w.bottle);w.mod.ResolvePendingReleases();CHECK(SKSE::tasks.queue.size()==1);
        w.FenceOffOn();SKSE::tasks.Drain();CHECK(w.player.pickupCalls==0);
        Mod::OnDropped(false,&w.bottle);w.mod.ResolvePendingReleases();SKSE::tasks.Drain();CHECK(w.player.pickupCalls==1);
    }else if(test=="draw_queue_epoch"){
        World w;CHECK(!w.mod.HandleHolsterAttempt(13,true,false));CHECK(SKSE::tasks.queue.size()==1);
        w.FenceOffOn();SKSE::tasks.Drain();CHECK(w.player.removeCalls==0);CHECK(!w.mod._pendingGrab[1].Active());
        CHECK(!w.mod.HandleHolsterAttempt(13,false,false));SKSE::tasks.Drain();CHECK(w.player.removeCalls==1);CHECK(w.mod._pendingGrab[0].Active());
    }else if(test=="draw_last_guard"){
        World w;const auto token=w.mod._demoSlots.CurrentToken();BodyPouches::Game::onHeld=[&]{w.OffOn();};
        CHECK(!w.mod.Draw(13,true,w.potion.item.key,5,token));CHECK(w.player.removeCalls==0);CHECK(!w.mod._pendingGrab[1].Active());
    }else if(test=="stow_last_guard"){
        World w;const auto token=w.mod._demoSlots.CurrentToken();BodyPouches::Game::onDescribe=[&]{w.OffOn();};
        w.mod.StowDropped(13,true,&w.bottle,1,token);CHECK(w.player.pickupCalls==0);
    }else if(test=="removed_survives"){
        World w;const auto token=w.mod._demoSlots.CurrentToken();CHECK(w.mod.Draw(13,true,w.potion.item.key,5,token));
        CHECK(w.player.removeCalls==1);CHECK(w.mod._pendingGrab[1].Active());CHECK(w.mod._grabReference[1].native_handle()==101);
        w.player.worn=false;w.Event();w.mod.RefreshDemoEquipment();CHECK(!w.mod._demoActive);
        CHECK(w.mod._pendingGrab[1].Active());CHECK(w.mod._pendingDrawIds[1]==5);CHECK(w.mod._grabReference[1].native_handle()==101);
        CHECK(w.player.removeCalls==1);CHECK(w.player.pickupCalls==0);CHECK(w.mod._pouches.SlotOfHand(true)==13);
        Mod::OnGrabbed(true,&w.bottle);CHECK(!w.mod._pendingGrab[1].Active());CHECK(w.mod._pendingDrawIds[1]==0);
        CHECK(w.player.removeCalls==1);CHECK(w.player.pickupCalls==0);
    }else if(test=="reset_before_callbacks"){
        World w;auto token=w.mod._demoSlots.CurrentToken();CHECK(token.Valid());
        w.mod.onTrace=[&](BodyPouches::Diagnostics::Event event){if(event==BodyPouches::Diagnostics::Event::LoadBegin)CHECK(!w.mod._demoSlots.CurrentToken().Valid());};
        w.mod.InvalidateWorld();CHECK(w.mod._demoSlots.resets==1);CHECK(w.mod._loadState.Blocked());CHECK(!w.mod._demoSlots.CurrentToken().Valid());
        w.mod._loadState.Complete();w.mod.RefreshDemoEquipment();CHECK(w.mod._demoSlots.CurrentToken()!=token);CHECK(!w.mod.DemoAllows(13,true,&token));
    }else if(test=="queued_world_reset"){
        World w;Mod::OnDropped(true,&w.bottle);w.mod.ResolvePendingReleases();CHECK(SKSE::tasks.queue.size()==1);
        w.mod.InvalidateWorld();w.mod._loadState.Complete();w.mod.RefreshDemoEquipment();SKSE::tasks.Drain();CHECK(w.player.pickupCalls==0);
        CHECK(!w.mod.HandleHolsterAttempt(13,true,false));CHECK(SKSE::tasks.queue.size()==1);w.mod.InvalidateWorld();w.mod._loadState.Complete();w.mod.RefreshDemoEquipment();SKSE::tasks.Drain();CHECK(w.player.removeCalls==0);
    }else if(test=="native13_only"){
        World w;const auto calls=w.mod._demoSlots.allows;CHECK(w.mod.PouchAt(true,0)==0);CHECK(w.mod.PouchAt(true,12)==0);
        CHECK(w.mod._demoSlots.allows==calls);CHECK(w.mod.PouchAt(true,13)==13);CHECK(w.mod.HandleHolsterAttempt(12,true,false));CHECK(SKSE::tasks.queue.empty());
        w.player.worn=false;w.Event();CHECK(!w.mod.HandleHolsterAttempt(13,true,false));CHECK(SKSE::tasks.queue.empty());
    }else if(test=="event_dirty_only"){
        World w;const auto old=w.mod._demoSlots.CurrentToken();const auto calls=w.mod._demoSlots.reconciles,reads=w.player.wornReads;
        w.Event();CHECK(w.mod._demoEquipmentDirty.load());CHECK(w.mod._demoSlots.CurrentToken()==old);CHECK(w.mod._demoSlots.reconciles==calls);CHECK(w.player.wornReads==reads);
        w.mod.RefreshDemoEquipment();CHECK(w.mod._demoSlots.CurrentToken()!=old);CHECK(!w.mod._demoEquipmentDirty.load());
    }else if(test=="map_revalidation"){
        World w;Mod::OnDropped(true,&w.bottle);w.mod._vrik.native=12;
        w.mod.onGeometry=[&](std::string_view phase){if(phase=="post_vrik_same_update"){w.mod._queuedDrops.clear();w.mod._queuedDrops[101]=999;}};
        w.mod.ResolvePendingReleases();CHECK(w.mod._queuedDrops.at(101)==999);CHECK(SKSE::tasks.queue.empty());CHECK(w.player.pickupCalls==0);
    }else if(test=="unavailable"){
        World w;Mod::OnDropped(true,&w.bottle);w.mod._demoSlots.provider=false;w.mod.ResolvePendingReleases();SKSE::tasks.Drain();CHECK(w.player.pickupCalls==0);
        CHECK(!w.mod.DemoAllows(13,true));CHECK(!w.mod._demoActive);
    }else throw std::runtime_error("unknown case");
}
}
int main(int argc,char** argv){
    if(argc==2)Run(argv[1]);
    else for(auto test:{"original_draw_capture","unassigned_stow_fence","normal_return","off_on_before_resolve","original_event_capture","queue_no_recapture","queued_return_epoch","draw_queue_epoch","draw_last_guard","stow_last_guard","removed_survives","reset_before_callbacks","queued_world_reset","native13_only","event_dirty_only","map_revalidation","unavailable"})Run(test);
    std::cout<<"checks="<<checks<<" failures="<<failures<<"\n";return failures?1:0;
}
