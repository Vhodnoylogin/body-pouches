namespace RE {
using FormID = std::uint32_t;
struct TESObjectREFR;
struct Ref { TESObjectREFR* pointer{}; TESObjectREFR* get() const { return pointer; } explicit operator bool() const { return pointer != nullptr; } };
inline std::map<std::uint32_t, TESObjectREFR*> references;
struct ObjectRefHandle {
    std::uint32_t value{};
    std::uint32_t native_handle() const { return value; }
    Ref get() const { const auto found=references.find(value); return {found==references.end()?nullptr:found->second}; }
    void reset() { value=0; }
};
struct TESForm {
    virtual ~TESForm() = default;
    FormID id{};
    const char* GetName() const { return "test potion"; }
    FormID GetFormID() const { return id; }
    int GetFormType() const { return 1; }
    template<class T> T* As() { return dynamic_cast<T*>(this); }
};
struct TESBoundObject : TESForm {};
struct TESObjectARMO : TESBoundObject {};
struct AlchemyItem : TESBoundObject { BodyPouches::Core::Item item; };
struct TESObjectREFR {
    FormID id{};
    std::uint32_t handle{};
    TESBoundObject* base{};
    bool deleted{},disabled{};
    struct Extra { int count=1; int GetCount() const { return count; } } extraList;
    std::function<void()> onBase;
    TESBoundObject* GetBaseObject() { auto callback=std::exchange(onBase,{}); if(callback)callback(); return base; }
    FormID GetFormID() const { return id; }
    ObjectRefHandle GetHandle() const { return {handle}; }
    bool IsDeleted() const { return deleted; }
    bool IsDisabled() const { return disabled; }
};
struct NiPoint3 { float x{},y{},z{}; };
struct Cell { bool attached=true; bool IsAttached() const { return attached; } };
enum class ITEM_REMOVE_REASON { kDropping };
struct PlayerCharacter {
    inline static PlayerCharacter* current{};
    bool has3D=true,worn=true;
    Cell cell;
    TESObjectARMO* armor{};
    TESObjectREFR* removed{};
    int removeCalls{},pickupCalls{},pickedQuantity{},wornReads{};
    std::function<void()> onWorn,onRemove,onPickup;
    static PlayerCharacter* GetSingleton() { return current; }
    void* Get3D(bool) { return has3D?this:nullptr; }
    Cell* GetParentCell() { return &cell; }
    TESObjectARMO* GetWornArmor(FormID form,bool) { ++wornReads; auto f=std::exchange(onWorn,{});if(f)f();return worn&&armor&&armor->id==form?armor:nullptr; }
    ObjectRefHandle RemoveItem(TESBoundObject*,int,ITEM_REMOVE_REASON,void*,void*,NiPoint3*,NiPoint3*) {
        ++removeCalls; auto f=std::exchange(onRemove,{});if(f)f(); return removed?removed->GetHandle():ObjectRefHandle{};
    }
    void PickUpObject(TESObjectREFR*,int count,bool,bool) { ++pickupCalls;pickedQuantity+=count;auto f=std::exchange(onPickup,{});if(f)f(); }
};
enum class BSEventNotifyControl { kContinue };
template<class T> struct BSTEventSource {};
struct ActorHandle { PlayerCharacter* value{}; PlayerCharacter* get() const { return value; } };
struct TESEquipEvent { ActorHandle actor; FormID baseObject{}; };
inline const char* FormTypeToString(int) { return "AlchemyItem"; }
}
using TESObjectREFR=RE::TESObjectREFR;

namespace SKSE {
struct Tasks {
    std::vector<std::function<void()>> queue;
    void AddTask(std::function<void()> f) { queue.push_back(std::move(f)); }
    void Drain() { auto pending=std::exchange(queue,{});for(auto& task:pending)task(); }
};
inline Tasks tasks;
inline bool available=true;
inline Tasks* GetTaskInterface() { return available?&tasks:nullptr; }
}

